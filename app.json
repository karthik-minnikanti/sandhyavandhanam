{
  "expo": {
    "name": "VedGayathri",
    "slug": "vedgayathri",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/gayatri-mata.jpg",
    "scheme": "vedgayathri",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/gayatri-mata.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#1a472a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vedgayathri.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-adaptive.png",
        "backgroundColor": "#1a472a"
      },
      "package": "com.vedgayathri.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/gayatri-mata.jpg"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/gayatri-mata.jpg",
          "color": "#1a472a",
          "sounds": []
        }
      ]
    ],
    "owner": "karthik.minnikanti",
    "extra": {
      "eas": {
        "projectId": "659e1acd-d8e1-4b63-b297-4011d334053f"
      }
    }
  }
}
