{
  "expo": {
    "name": "Sandhyavandanam",
    "slug": "sandhyavandanam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gayatri-mata.jpg",
    "scheme": "sandhyavandanam",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/gayatri-mata.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#1a472a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sandhyavandanam.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-adaptive.png",
        "backgroundColor": "#1a472a"
      },
      "package": "com.sandhyavandanam.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/gayatri-mata.jpg"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/gayatri-mata.jpg",
          "color": "#1a472a",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fe76a9c5-00e9-4151-b99a-4cb03b9636d1"
      }
    }
  }
}
